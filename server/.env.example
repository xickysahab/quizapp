DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/quiz?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
FRONTEND_URL="http://localhost:5173"
PORT=5000

# Set to "production" on a deployed server. Among other things this closes the
# "first login becomes admin" fallback, leaving ADMIN_EMAIL/ADMIN_PASSWORD as the
# only way to create the first account.
NODE_ENV="development"

# Only set when the server sits behind a reverse proxy (Render, Fly, nginx).
# Number of proxy hops to trust. Leaving it unset on a directly-exposed server is
# correct; setting it there would let clients spoof their IP past the rate limiter.
# TRUST_PROXY=1

# Redis. Required to run more than one instance: it backs the Socket.IO adapter
# (so a broadcast from one instance reaches participants on another) plus the
# shared live-quiz state and rate limiter. Without it the server still works, but
# only as a single instance.
# REDIS_URL="redis://localhost:6379"

# Postgres pool size (default 20). Render Postgres allows 97 connections by
# default; keep this comfortably below that.
# DB_POOL_MAX=20

# Per-IP cap on POST /participants/join. A venue shares one NAT IP, so keep this
# comfortably above the largest audience you expect to admit in a single minute.
# JOIN_RATE_LIMIT_PER_MINUTE=600
