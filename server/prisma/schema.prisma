generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name        String
  role        String        @default("HOST")
  events      Event[]
  activityLogs ActivityLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id                String        @id @default(uuid())
  title             String
  roomCode          String        @unique
  hostId            String
  host              User          @relation(fields: [hostId], references: [id])
  isLive            Boolean       @default(false)
  currentQuestionId String?
  currentQuestion   Question?     @relation("ActiveQuestion", fields: [currentQuestionId], references: [id], onDelete: SetNull)
  // Persisted so time limits survive a server restart (in-memory live state is lost).
  currentQuestionStartedAt DateTime?
  concludeConfig    Json?
  questions         Question[]
  participants      Participant[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([hostId])
}

model Question {
  id            String     @id @default(uuid())
  eventId       String
  event         Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  text          String
  imageUrl      String?
  description   String?
  options       String[]
  correctOption Int?
  order         Int
  timeLimit     Int?
  responses     Response[]
  activeForEvents Event[]  @relation("ActiveQuestion")

  @@index([eventId, order])
}

model Participant {
  id        String     @id @default(uuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  // Bearer secret handed to the participant on join; proves they own this row.
  // Optional so rows created before this field existed can still rejoin by name.
  joinToken String?    @unique
  socketId  String?
  responses Response[]
  joinedAt  DateTime   @default(now())

  @@unique([eventId, name])
  @@index([eventId])
}

model Response {
  id             String      @id @default(uuid())
  questionId     String
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participantId  String
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  selectedOption Int
  isCorrect      Boolean     @default(false)
  respondedAt    DateTime    @default(now())

  @@unique([questionId, participantId])
  @@index([participantId])
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  resource   String
  resourceId String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
